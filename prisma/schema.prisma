// Task Secretary database schema.
// After changing this file, run `npm run db:migrate` to create a migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication tables (structure required by Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  // IANA time zone used to interpret the user's task dates and times.
  timeZone      String   @default("Europe/Tallinn")

  sessions        Session[]
  accounts        Account[]
  tasks           Task[]
  categories      Category[]
  recurringSeries RecurringSeries[]
  reminders       Reminder[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Stores how a user signs in. For email + password login, the
// securely hashed password is kept in `password` (never the plain text).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Task Secretary tables
// ---------------------------------------------------------------------------

// Declared from most to least important: PostgreSQL sorts enum values in
// declaration order, so sorting by importance ascending puts HIGH first.
enum Importance {
  HIGH
  NORMAL
  LOW
}

// "Overdue" is not a status; it is calculated from the deadline and the
// current time in the user's time zone.
enum TaskStatus {
  TODO
  IN_PROGRESS
  POSTPONED
  COMPLETED
}

// Planned and deadline values are stored as the user's local calendar date
// and optional wall-clock time (no time = the whole day). They are read in the
// owner's users.timeZone, so they never shift if that time zone changes.
model Task {
  id                   String     @id @default(cuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String     @db.VarChar(200)
  description          String?
  importance           Importance @default(NORMAL)
  status               TaskStatus @default(TODO)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  // When the user intends to work on the task.
  plannedDate          DateTime?  @db.Date
  plannedTime          DateTime?  @db.Time(0)
  // When the task must be finished.
  deadlineDate         DateTime?  @db.Date
  deadlineTime         DateTime?  @db.Time(0)
  // First deadline date ever assigned; never changes afterwards.
  originalDeadlineDate DateTime?  @db.Date
  // How many times an existing deadline date was changed or removed.
  rescheduleCount      Int        @default(0)
  estimatedMinutes     Int?
  completedAt          DateTime?
  // Optional; must be one of the owner's categories (checked by the server).
  // Deleting the category keeps the task and clears this field.
  categoryId           String?
  category             Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Recurring tasks. A task belongs to no series or to exactly one series of the
  // same user (the composite key makes the database enforce "same user").
  seriesId      String?
  series        RecurringSeries? @relation(fields: [seriesId, userId], references: [id, userId], onDelete: NoAction)
  // The scheduled occurrence this task stands for: "2026-11-09" or
  // "2026-11-09T09:00". It does not change when the planned date is postponed.
  occurrenceKey String?
  // The instance whose completion created this one. Unique, so one instance can
  // never have two successors.
  predecessorId String?          @unique
  predecessor   Task?            @relation("TaskSuccession", fields: [predecessorId], references: [id], onDelete: SetNull)
  successor     Task?            @relation("TaskSuccession")

  // Trash and archive. Active = both empty. deletedAt: in Trash (recoverable for 30 days).
  // archivedAt: archived (finished tasks only; the database checks it). purgedAt: a tombstone, the
  // scrubbed remains of a permanently deleted occurrence of a series (it only keeps the occurrence
  // key so the date is never generated again; it is never listed, restored or shown).
  deletedAt  DateTime?
  archivedAt DateTime?
  purgedAt   DateTime?

  reminders Reminder[]

  // The same occurrence of a series can never exist twice.
  @@unique([seriesId, occurrenceKey])
  // Lets reminders point at "this task of this user" (the database enforces same user).
  @@unique([id, userId])
  @@index([userId, deletedAt, archivedAt])
  @@index([userId, status, deadlineDate])
  @@index([categoryId])
  @@map("tasks")
}

// The fixed palette users choose category colours from.
enum CategoryColor {
  RED
  AMBER
  LIME
  TEAL
  SKY
  INDIGO
  PURPLE
  PINK
}

model Category {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // As typed by the user (trimmed).
  name           String        @db.VarChar(50)
  // Lower-case copy of the name, so "TMJK" and "tmjk" count as the same name.
  normalizedName String
  color          CategoryColor
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tasks           Task[]
  recurringSeries RecurringSeries[]

  // Category names are unique per user, ignoring upper/lower case.
  @@unique([userId, normalizedName])
  @@map("categories")
}

enum RecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM_WEEKDAYS
}

// ACTIVE: creates the next instance when the latest one is completed.
// PAUSED: creates nothing until resumed (indefinitely, or until pausedUntil).
// ENDED: the end date has been reached; reversible by extending the end date.
// STOPPED: recurrence was turned off; final.
enum SeriesState {
  ACTIVE
  PAUSED
  ENDED
  STOPPED
}

// A recurring series: its schedule and the template new instances are copied
// from. Independent of the individual tasks (instances) it produced.
// Dates are wall-clock values in Europe/Tallinn (see src/lib/recurrence).
model RecurringSeries {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Schedule. weekdays are ISO numbers (1 = Monday … 7 = Sunday): exactly one for
  // WEEKLY, one or more for CUSTOM_WEEKDAYS, none otherwise.
  type        RecurrenceType
  weekdays    Int[]
  // The ORIGINAL day of the month (1-31); shorter months use their last day.
  monthlyDay  Int?
  // Planned date of the first instance; recurrence is anchored to planned dates.
  anchorDate  DateTime       @db.Date
  // null = date-only series.
  plannedTime DateTime?      @db.Time(0)

  // Template copied into every new instance.
  title              String     @db.VarChar(200)
  description        String?
  importance         Importance @default(NORMAL)
  estimatedMinutes   Int?
  // Deleting the category keeps the series and clears this field.
  categoryId         String?
  category           Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Deadline = planned date + this many calendar days, at deadlineTime.
  // null offset = no deadline.
  deadlineOffsetDays Int?
  deadlineTime       DateTime?  @db.Time(0)

  // Last date an occurrence may fall on (inclusive); null = no end.
  endDate     DateTime?   @db.Date
  state       SeriesState @default(ACTIVE)
  pausedUntil DateTime?   @db.Date
  // Increases with every change; edits made from a stale copy are rejected.
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tasks Task[]

  // Lets tasks reference (id, userId), so a task can only belong to its owner's series.
  @@unique([id, userId])
  @@index([userId, state, pausedUntil])
  @@index([categoryId])
  @@map("recurring_series")
}

enum ReminderType {
  DAY_BEFORE
  DUE_DAY
}

// One row per reminder event. The unique rule on (taskId, type, forDueDate)
// guarantees the same reminder can never be created twice.
model Reminder {
  id           String       @id @default(cuid())
  taskId       String
  task         Task         @relation(fields: [taskId, userId], references: [id, userId], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ReminderType
  // The deadline this reminder belongs to. A new deadline means new reminders.
  forDueDate   DateTime     @db.Date
  // When the reminder should first appear (09:00 Europe/Tallinn).
  scheduledAt  DateTime
  // Set by "Remind Later": the reminder stays hidden until this moment.
  snoozedUntil DateTime?
  // Set when the user has read it; cleared again by "Remind Later".
  readAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([taskId, type, forDueDate])
  @@index([userId, scheduledAt])
  @@map("reminders")
}
