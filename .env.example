# Copy this file to ".env" and fill in real values. Never commit ".env".

# PostgreSQL connection string (local PostgreSQL now, Railway PostgreSQL later).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/task_secretary"

# Better Auth secret used to sign login sessions (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Public address of the app (http://localhost:3000 locally, the Railway URL later).
BETTER_AUTH_URL="http://localhost:3000"
